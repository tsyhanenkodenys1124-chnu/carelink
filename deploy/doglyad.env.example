# Приклад файла середовища для systemd. Скопіюйте у /etc/doglyad/doglyad.env
# і виставте права: chown root:doglyad, chmod 640 — усередині приватні ключі.

# --- Основне ---
ADDR=127.0.0.1:8080
DATABASE_PATH=/var/lib/doglyad/doglyad.db
MEDIA_DIR=/var/lib/doglyad/media
WEB_DIR=/opt/doglyad/web
PUBLIC_URL=https://care.example.org
WEB_ORIGIN=https://care.example.org
COOKIE_SECURE=true

# --- Web Push ---
# Ключі створює команда: /opt/doglyad/doglyad-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@care.example.org

# --- Telegram ---
# Токен видає @BotFather. BOT_NAME — ім'я бота без символу @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# --- Пошта ---
# Без цих значень листи не надсилаються, а лише потрапляють у журнал сервера.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=doglyad@care.example.org
SMTP_STARTTLS=true
