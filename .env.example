# Локальні значення для розробки. Справжні секрети в Git не потрапляють.
ADDR=:8080
DATABASE_PATH=./data/doglyad.db
MEDIA_DIR=./data/media
WEB_DIR=../web/dist
WEB_ORIGIN=http://127.0.0.1:5173
PUBLIC_URL=http://127.0.0.1:8080
COOKIE_SECURE=false

# Web Push. Створити ключі: cd backend && go run ./cmd/keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Telegram. Без токена канал працює в журнальному режимі.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Пошта. Без SMTP_HOST листи друкуються в журнал сервера — зручно для розробки.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
